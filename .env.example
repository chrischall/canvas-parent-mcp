CANVAS_BASE_URL=https://cms.instructure.com
CANVAS_NAME=cms

# === Auth mode A (zero-config) — fetchproxy fallback ===
# Leave all CANVAS_* auth vars below empty. Install the ContextMint Bridge
# browser extension and sign into your Canvas instance. The MCP reads your
# `canvas_session` + `pseudonym_credentials` cookies lazily on the first
# request and again on every 401 (session expiry), so keep the extension
# installed and your browser running while you use the MCP.
# https://github.com/nullnet-app/contextmint-bridge/releases
# (It's the fetchproxy extension renamed, same maintainer — see
# https://github.com/chrischall/fetchproxy#extension. Verify a release zip
# with `shasum -a 256 -c <zip>.sha256`, or build it from source.)

# Set CANVAS_DISABLE_FETCHPROXY=1 to opt out (missing creds become a hard
# error — useful in headless CI).
# CANVAS_DISABLE_FETCHPROXY=

# === Auth mode B — username/password (legacy session-scrape) ===
# Direct Canvas accounts only — no SSO/2FA. Brittle: breaks on every Canvas
# login-page restyling. Prefer fetchproxy (mode A) if your tab is already
# signed in.
# CANVAS_USERNAME=
# CANVAS_PASSWORD=

# === Auth mode C — personal access token ===
# Simplest if your admin allows it. Generate via Canvas: Account → Settings
# → "+ New Access Token". Most institutions have disabled this for non-admins.
# CANVAS_TOKEN=

# === Auth mode D — OAuth ===
# Useful when SSO blocks both fetchproxy and username/password.
#   1. In Canvas web, open Account -> QR for Mobile Login.
#   2. Decode the QR with any reader (the result is an https://sso.canvaslms.com URL).
#   3. Run: canvas-parent-mcp-qr-login "<qr-url>" >> .env
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=
# CANVAS_REFRESH_TOKEN=

# Optional: the session is cached between runs so a restart does not
# re-authenticate (username/password and OAuth modes only — token and
# fetchproxy modes never write it). The cache holds the live session cookies
# or OAuth access token IN PLAINTEXT, owner-only (0600 file in a 0700 dir).
# Set to false on shared or backed-up machines (Time Machine, cloud sync) to
# keep the session in memory only.
# CANVAS_SESSION_CACHE=false
# Optional: where that cache lives. Defaults to $MCP_DATA_DIR/.canvas-parent-mcp/session.json.
# CANVAS_SESSION_FILE=/path/to/cache.json
