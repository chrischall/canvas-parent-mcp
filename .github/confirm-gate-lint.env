# Placeholder config for the fleet confirm-gate lint (chrischall/workflows,
# reusable-mcp-ci.yml; fleet-audit#945). NOT real credentials — never put one
# here. The lint starts dist/index.js with an empty environment and reads its
# tools/list; unconfigured, this server registers only canvas_healthcheck (see
# src/index.ts), which would hide every other tool from the lint. Token mode
# needs no network at startup, so these two lines make it register all tools.
CANVAS_BASE_URL=https://canvas.example.invalid
CANVAS_TOKEN=placeholder-not-a-real-token
